<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Define the RollingFileAppender for JSON logs -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/var/log/egejavaapp/application.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rollover -->
            <fileNamePattern>/var/log/egejavaapp/application.%d{dd-MM-yyyy}.json</fileNamePattern>
            <!-- Keep 30 days' worth of logs -->
            <maxHistory>30</maxHistory>
            <!-- Set the maximum size of the log file -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <!-- Encode logs in JSON format -->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder" />
    </appender>

    <!-- Define the asynchronous appender -->
    <appender name="ASYNC_JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_FILE"/>
        <queueSize>5000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <maxFlushTime>1000</maxFlushTime>
        <includeCallerData>true</includeCallerData>
    </appender>

    <!-- Set the root logger level to TRACE to capture all levels -->
    <root level="TRACE">
        <appender-ref ref="ASYNC_JSON_FILE"/>
    </root>

    <logger name="com.samplejavaapp" level="INFO">
        <appender-ref ref="ASYNC_JSON_FILE"/>
    </logger>

    <logger name="com.samplejavaapp.debug" level="DEBUG">
        <appender-ref ref="ASYNC_JSON_FILE"/>
    </logger>

    <logger name="com.samplejavaapp.trace" level="TRACE">
        <appender-ref ref="ASYNC_JSON_FILE"/>
    </logger>

    <logger name="com.samplejavaapp.warn" level="WARN">
        <appender-ref ref="ASYNC_JSON_FILE"/>
    </logger>

    <logger name="com.samplejavaapp.error" level="ERROR">
        <appender-ref ref="ASYNC_JSON_FILE"/>
    </logger>

</configuration>
