apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ ingress_name }}
  namespace: {{ app_namespace }}
spec:
  ingressClassName: nginx
  rules:
  - host: {{ ingress_host_name }}
    http:
      paths:
      - path: {{ ingress_http_path }}
        pathType: Prefix
        backend:
          service:
            name: {{ service_name }}
            port: 
              number: {{ service_port_number }}